{
  "name": "Suraksha Saathi — Ink & Cobalt",
  "version": "1.0.0",
  "defaultTheme": "light",
  "followSystemTheme": false,
  "themes": {
    "light": {
      "canvas": "#F6F7FB",
      "surface": "#FFFFFF",
      "surfaceSecondary": "#EDF1F7",
      "text": "#14263D",
      "textSecondary": "#55657B",
      "border": "#D7DFEA",
      "controlBorder": "#7C8AA3",
      "primary": "#3157D5",
      "onPrimary": "#FFFFFF",
      "primarySubtle": "#E9EEFF",
      "featuredSurface": "#ECF1FC",
      "success": "#13664D",
      "successSurface": "#E6F4EE",
      "warning": "#80520B",
      "warningSurface": "#FFF3DC",
      "danger": "#AC343B",
      "dangerSurface": "#FDECEE"
    },
    "dark": {
      "canvas": "#101720",
      "surface": "#192331",
      "surfaceSecondary": "#222F40",
      "text": "#ECF2FA",
      "textSecondary": "#AEBBD0",
      "border": "#34445A",
      "controlBorder": "#6A809C",
      "primary": "#A4BAFF",
      "onPrimary": "#142550",
      "primarySubtle": "#243455",
      "featuredSurface": "#1C2C45",
      "success": "#84DABD",
      "successSurface": "#193C32",
      "warning": "#EAC482",
      "warningSurface": "#3A3021",
      "danger": "#FFAFB5",
      "dangerSurface": "#40262D"
    }
  },
  "spacing": [4, 8, 12, 16, 20, 24, 32, 40, 48],
  "radius": { "compact": 10, "control": 12, "panel": 16, "deviceFrame": 28 },
  "type": {
    "latinFamily": "Inter",
    "devanagariFamily": "Noto Sans Devanagari",
    "weights": [400, 500],
    "androidScaleSp": { "display": 32, "screenTitle": 24, "sectionTitle": 20, "body": 16, "supporting": 14 },
    "note": "Production targets; inline preview inherits host heading sizes. Santali font selection remains subject to glyph and native-speaker review."
  },
  "controls": { "primaryMinHeightDp": 56, "assessmentChoiceMinHeightDp": 64, "secondaryMinHeightDp": 48, "iconHitTargetDp": 48, "focusOutlinePx": 2, "focusOffsetPx": 3 },
  "motion": { "interactionMs": 140, "stateTransitionMs": 180, "respectReducedMotion": true }
}
